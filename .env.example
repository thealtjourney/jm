# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The driver is picked from the host: *.neon.tech uses the serverless WebSocket
# driver, anything else uses node-postgres.
#
# On Vercel, use the POOLED Neon connection string:
DATABASE_URL="postgres://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/journeymanager?sslmode=require"
#
# Optional: the direct, unpooled URL. Used by drizzle-kit for migrations only.
# DIRECT_URL="postgres://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/journeymanager?sslmode=require"
#
# Local development against Docker Postgres:
# DATABASE_URL="postgres://postgres:devpass@localhost:55432/journeymanager"
#
# Force a driver instead of detecting it: "neon" or "node".
# DB_DRIVER="node"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Shared password that unlocks edit mode in the app.
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
